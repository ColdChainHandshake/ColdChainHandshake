{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Host tests (any C++20 compiler; on Windows, MSYS2 g++)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Host tests with ASan and UBSan (clang on Linux or WSL only)",
      "inherits": "host-tests",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CCH_SANITIZE": "ON" }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets (clang on Linux or WSL only)",
      "inherits": "host-tests",
      "binaryDir": "${sourceDir}/build/fuzz",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CCH_FUZZ": "ON", "CCH_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "host-tests", "configurePreset": "host-tests" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    { "name": "host-tests", "configurePreset": "host-tests", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } }
  ]
}
